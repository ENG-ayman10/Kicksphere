PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000

# Required in production. Use a long random value and never commit the real secret.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRY=30d

# Required in production. Comma-separated origins, for example:
# ALLOWED_ORIGINS=https://your-app.example.com,https://admin.your-app.example.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Firebase Admin SDK. Prefer these env vars in production.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"

# External football data providers.
FOOTBALL_DATA_API_KEY=replace-me
KICKOFF_API_KEY=replace-with-kickoff-api-key
ENABLE_SOFASCORE_PROXY=false
ENABLE_RAPIDAPI_PROXY=false
RAPID_API_KEY=replace-me
RAPID_API_HOST=free-api-live-football-data.p.rapidapi.com

# Demo news is disabled by default because it is not real news.
ENABLE_DEMO_NEWS=false

# Background Socket.io polling is opt-in to avoid unintended provider traffic.
ENABLE_LIVE_POLLING=false

# Firestore reference seeding is opt-in and uses merge writes only.
ALLOW_FIRESTORE_SEED=false
